{
  "name": "lecture-presentation",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p test-ui/tsconfig.json && tsc -p test-browser/tsconfig.json",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:browser:install": "playwright install chromium webkit",
    "test:browser:report": "playwright show-report",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
